{
  "info": {
    "name": "API Battle - FIFA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://177.44.248.73:3000"
    },
    {
      "key": "apiKey",
      "value": "fifa-battle-2026"
    }
  ],
  "item": [
    {
      "name": "POST /fifa - insere jogador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", ()=>pm.response.to.have.status(201));",
              "pm.test(\"Tempo (ms): \"+pm.response.responseTime, ()=>true);",
              "pm.test(\"Retorna player_id\", ()=>pm.expect(pm.response.json().player_id).to.be.a(\"number\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/fifa",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "fifa"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player_name\": \"Teste Postman\",\n  \"age\": 25,\n  \"nationality\": \"Brazil\",\n  \"club\": \"Gremio\",\n  \"position\": \"ST\",\n  \"overall_rating\": 80,\n  \"potential_rating\": 85,\n  \"matches_played\": 30,\n  \"goals\": 15,\n  \"assists\": 7,\n  \"minutes_played\": 2500,\n  \"market_value_million_eur\": 20.5,\n  \"contract_years_left\": 3,\n  \"injury_prone\": \"No\",\n  \"transfer_risk_level\": \"Low\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
